# ---------- App ----------
APP_ENV=prod
DEBUG=false
SECRET_KEY=change-me-please
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ---------- Database (PostgreSQL) ----------
DB_HOST=db
DB_PORT=5432
DB_NAME=expense_db
