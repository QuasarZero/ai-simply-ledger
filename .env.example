# ---------- App ----------
APP_ENV=prod
DEBUG=false
SECRET_KEY=change-me-please
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
TIMEZONE=Asia/Shanghai

# ---------- Database (PostgreSQL) ----------
DB_HOST=database
DB_PORT=5432
DB_NAME=expense_db
DB_USER=expense_user
DB_PASSWORD=expense_pass_change_me

# ---------- Docker Postgres init user/db ----------
POSTGRES_DB=expense_db
POSTGRES_USER=expense_user
POSTGRES_PASSWORD=expense_pass_change_me

# ---------- FX ----------
# Provider chain (in order). Later providers will only be called to fill missing days/currencies.
FX_PROVIDERS=frankfurter,fawazahmed,openexchangerates,freecurrencyapi,floatrates
# Currencies to sync/store (USD is used as base for daily rates)
# Initial default enabled currencies (used only for first-time DB seeding).
FX_CURRENCIES=USD,CNY,EUR,JPY,HKD,GBP

# Optional API keys (only required if you enable the provider in FX_PROVIDERS)
OPENEXCHANGERATES_APP_ID=
FREECURRENCYAPI_KEY=

# ---------- Email (Password reset) ----------
# EMAIL_MODE=log will print reset URL to backend container logs.
# EMAIL_MODE=smtp will send real email via SMTP.
FRONTEND_BASE_URL=http://localhost:8080
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
EMAIL_MODE=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
SMTP_SSL=false

# ---------- Logs ----------
# Container path; mounted to ./logs by docker-compose.yml
LOG_DIR=/app/logs

# ---------- Default admin ----------
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=123qaz
